---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations, languages } from "../../i18n/utils";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title="DCP Cloud | Workspace">
	<!-- Markdown Parsers via CDN -->
	<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"
	></script>
	<script
		is:inline
		src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"
	></script>

	<style is:global>
		/* Markdown formatting refinements */
		.prose pre {
			background-color: #0f172a !important;
			border: 1px solid #334155;
			border-radius: 0.5rem;
			padding: 1rem;
		}
		.prose code {
			color: #38bdf8;
			background-color: rgba(30, 41, 59, 0.8);
			padding: 0.2rem 0.4rem;
			border-radius: 0.25rem;
			font-size: 0.875em;
		}
		.prose pre code {
			color: #e2e8f0;
			background-color: transparent;
			padding: 0;
		}
		.prose p {
			margin-bottom: 0.75rem;
		}
		.prose p:last-child {
			margin-bottom: 0;
		}
		.prose ul {
			list-style-type: disc;
			padding-inline-start: 1.5rem;
			margin-bottom: 0.75rem;
		}
		.prose ol {
			list-style-type: decimal;
			padding-inline-start: 1.5rem;
			margin-bottom: 0.75rem;
		}
		.prose pre {
			background-color: #0f172a !important;
			border: 1px solid #334155;
			border-radius: 0.5rem;
			padding: 1rem;
			overflow-x: auto;
			white-space: pre;
			word-break: normal;
			overflow-wrap: normal;
		}
		.prose pre code {
			background: transparent;
			padding: 0;
		}
	</style>

	<div class="flex flex-col h-screen w-full bg-slate-950">
		<!-- Top Navigation Header -->
		<header
			class="border-b border-slate-800/80 bg-slate-900/50 backdrop-blur-md flex-none px-6 py-3.5 flex items-center justify-between"
		>
			<div class="flex items-center gap-3">
				<a
					href={`/${lang}/`}
					class="p-2 -ms-2 hover:bg-slate-800 text-slate-400 hover:text-slate-200 rounded-lg transition"
					title={t("chat.backHome")}
				>
					<i data-lucide="arrow-left" class="w-5 h-5"></i>
				</a>
				<div
					class="h-9 w-9 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/20"
				>
					<i data-lucide="cpu" class="w-5 h-5 text-white"></i>
				</div>
				<div>
					<div class="flex items-center gap-2">
						<h1 class="font-semibold text-sm tracking-tight text-slate-200">
							{t("chat.headerTitle")}
						</h1>
						<span
							class="bg-emerald-500/10 text-emerald-400 text-[10px] font-medium px-2 py-0.5 rounded-full border border-emerald-500/20 flex items-center gap-1"
						>
							<span
								class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"
							></span> Active
						</span>
					</div>
					<p class="text-xs text-slate-400">{t("chat.modelInfo")}</p>
				</div>
			</div>

			<div class="flex items-center gap-3">
				<div
					class="hidden sm:flex items-center gap-2 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-lg text-xs text-slate-400"
				>
					<i data-lucide="hard-drive" class="w-3.5 h-3.5 text-sky-400"></i>
					<span>{t("chat.cacheStatus")}</span>
				</div>
				<button
					id="reset-chat-btn"
					class="p-2 hover:bg-slate-800 text-slate-400 hover:text-slate-200 rounded-lg transition"
					title={t("chat.reset")}
				>
					<i data-lucide="rotate-ccw" class="w-4 h-4"></i>
				</button>
			</div>
		</header>

		<!-- Main Chat Canvas -->
		<main
			class="flex-1 overflow-y-auto px-4 sm:px-6 py-6 flex flex-col items-center"
		>
			<div id="chat-container" class="w-full max-w-3xl space-y-6 pb-4">
				<div
					id="welcome-banner"
					class="text-center py-12 px-4 rounded-2xl bg-gradient-to-b from-slate-900/40 to-slate-900/0 border border-slate-800/50 mt-6"
				>
					<div
						class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center mx-auto mb-4"
					>
						<i data-lucide="sparkles" class="w-6 h-6"></i>
					</div>
					<h3 class="text-base font-medium text-slate-200">
						{t("chat.welcomeTitle")}
					</h3>
					<p class="text-xs text-slate-400 max-w-md mx-auto mt-1">
						{t("chat.welcomeDesc")}
					</p>
				</div>
			</div>
		</main>

		<!-- Input Footer Bar -->
		<footer
			class="border-t border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-4 sm:p-6 flex-none"
		>
			<div class="max-w-3xl mx-auto">
				<form id="input-form" class="relative flex items-center">
					<textarea
						id="user-input"
						rows="1"
						placeholder={t("chat.placeholder")}
						class="w-full bg-slate-950 border border-slate-800 rounded-xl ps-4 pe-14 py-3 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 resize-none shadow-inner transition overflow-y-auto"
					></textarea>
					<button
						type="submit"
						id="send-btn"
						class="absolute end-2.5 h-8 w-8 bg-sky-500 hover:bg-sky-400 text-slate-950 rounded-lg flex items-center justify-center transition disabled:opacity-40 disabled:hover:bg-sky-500 cursor-pointer shadow-md shadow-sky-500/10"
						disabled
					>
						<i data-lucide="arrow-up" class="w-4 h-4 stroke-[2.5]"></i>
					</button>
				</form>
				<div
					class="flex items-center justify-between mt-2 px-1 text-[11px] text-slate-500"
				>
					<span>{t("chat.shiftEnter")}</span>
					<span id="token-counter">{t("chat.tokenContext")}</span>
				</div>
			</div>
		</footer>
	</div>

	<script is:inline define:vars={{ lang }}>
		
		// --- Auth Guard ---
		const token = localStorage.getItem("token");
		const expiry = localStorage.getItem("token_expiry");

		// Check expiry logic
		const isExpired = () => {
			if (!token || !expiry) return true;
			const expiryTime = !isNaN(expiry)
				? String(expiry).length === 10
					? Number(expiry) * 1000
					: Number(expiry)
				: new Date(expiry).getTime();
			return Date.now() > expiryTime;
		};

		if (isExpired()) {
			window.location.href = `/${lang}/`; // Redirect home if not logged in
		}

		if (window.marked) {
			marked.setOptions({
				gfm: true,           // Enable GitHub Flavored Markdown (needed for fenced code blocks)
				breaks: false,       // Keep line breaks as <br> disabled (default)
			});
		}

		// --- Chat Logic ---
		const BASE_URL = "https://ln.tejory.io";

		let chatHistory = [];
		let sessionId = crypto.randomUUID();

		const inputField = document.getElementById("user-input");
		const sendBtn = document.getElementById("send-btn");
		const form = document.getElementById("input-form");
		const resetBtn = document.getElementById("reset-chat-btn");

		inputField.addEventListener("input", function () {
			sendBtn.disabled = this.value.trim() === "";
			this.style.height = "auto";
			this.style.height =
				(this.scrollHeight < 120 ? this.scrollHeight + 2 : 120) + "px";
		});

		inputField.addEventListener("keydown", function (event) {
			if (event.key === "Enter" && !event.shiftKey) {
				event.preventDefault();
				if (inputField.value.trim() !== "") {
					form.dispatchEvent(new Event("submit"));
				}
			}
		});

		resetBtn.addEventListener("click", () => {
			sessionId = crypto.randomUUID();
			chatHistory = [];
			const container = document.getElementById("chat-container");
			container.innerHTML = `
        <div id="welcome-banner" class="text-center py-12 px-4 rounded-2xl bg-gradient-to-b from-slate-900/40 to-slate-900/0 border border-slate-800/50 mt-6">
          <div class="w-12 h-12 rounded-2xl bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center mx-auto mb-4">
            <i data-lucide="sparkles" class="w-6 h-6"></i>
          </div>
          <h3 class="text-base font-medium text-slate-200">Ready for Enterprise Workloads</h3>
          <p class="text-xs text-slate-400 max-w-md mx-auto mt-1">Streaming responses live via local cache architecture. Type a prompt below to begin.</p>
        </div>
      `;
			lucide.createIcons();
			document.getElementById("token-counter").textContent =
				"Context: Session reset";
		});


		const MATH_UNDERSCORE_PLACEHOLDER = 'MATHUNDERSCOREPLACEHOLDER';

		function protectMathUnderscores(text) {
			if (!text) return text;
			let result = text;
			// Protect display math $$...$$
			result = result.replace(/\$\$([\s\S]+?)\$\$/g, (match, inner) => {
				return '$$' + inner.replace(/_/g, MATH_UNDERSCORE_PLACEHOLDER) + '$$';
			});
			// Protect inline math $...$ (not preceded by $ or \)
			result = result.replace(/(^|[^\\$])\$([^$\n]+?)\$/g, (match, prefix, inner) => {
				return prefix + '$' + inner.replace(/_/g, MATH_UNDERSCORE_PLACEHOLDER) + '$';
			});
			return result;
		}

		function applyAutoDirection(container) {
			// Add dir="auto" to common block elements that contain text
			container.querySelectorAll('p, li, blockquote, h1, h2, h3, h4, h5, h6, td, th').forEach((el) => {
				el.setAttribute('dir', 'auto');
			});
		}

		function restoreMathUnderscores(html) {
			return html.split(MATH_UNDERSCORE_PLACEHOLDER).join('_');
		}

		function applyHighlighting(container) {
			if (window.hljs) {
				container.querySelectorAll('pre code').forEach((block) => {
					hljs.highlightElement(block);
				});
			}
		}

		// Helper function to unescape HTML entities and Unicode escapes
		function unescapeHtmlEntities(str) {
			if (!str) return str;

			// First pass: replace common HTML entities
			let result = str
				.replace(/&lt;/g, "<")
				.replace(/&gt;/g, ">")
				.replace(/&amp;/g, "&")
				.replace(/&quot;/g, '"')
				.replace(/&#39;/g, "'")
				.replace(/&apos;/g, "'");

			// Handle unicode escapes like \u003c, \u003e, \u003C, \u003E
			result = result.replace(/\\u([0-9A-Fa-f]{4})/g, (match, hex) => {
				return String.fromCharCode(parseInt(hex, 16));
			});

			return result;
		}

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const text = inputField.value.trim();
			if (!text) return;

			const banner = document.getElementById("welcome-banner");
			if (banner) banner.remove();

			inputField.value = "";
			inputField.style.height = "auto";
			inputField.disabled = true;
			sendBtn.disabled = true;

			appendMessage("user", text);
			chatHistory.push({ role: "user", content: text });

			const assistantMsgDiv = appendMessage("assistant", "");
			let displayContent = "";
			let hasReceivedContent = false;
			let hasThinking = false;
			let suggestionsBuffer = "";
			let isInSuggestions = false;
			let thinkingAnimationInterval = null;
			let rawBuffer = ""; // Buffer to handle partial tags

			try {
				const response = await fetch(`${BASE_URL}/api/v1/chat/completions`, {
					method: "POST",
					headers: {
						"Content-Type": "application/json",
						Authorization: `Bearer ${token}`,
					},
					body: JSON.stringify({
						sessionId: sessionId,
						model: "fast",
						message: text,
					}),
				});

				if (response.status === 401) {
					localStorage.removeItem("token");
					window.location.href = `/${lang}/`;
					return;
				}

				if (!response.ok)
					throw new Error(`HTTP ${response.status}: ${response.statusText}`);

				const reader = response.body.getReader();
				const decoder = new TextDecoder("utf-8");
				let buffer = "";

				// Show thinking animation immediately
				const thinkingDots = ["·", "··", "···", "····"];
				let dotIndex = 0;
				assistantMsgDiv.innerHTML = `<div class="flex items-center gap-2 text-slate-400 py-1">
          <span class="text-sky-400">Thinking</span>
          <span class="thinking-dots" style="min-width: 20px;">...</span>
        </div>`;
				lucide.createIcons();

				thinkingAnimationInterval = setInterval(() => {
					const dotsSpan = assistantMsgDiv.querySelector(".thinking-dots");
					if (dotsSpan) {
						dotIndex = (dotIndex + 1) % thinkingDots.length;
						dotsSpan.textContent = thinkingDots[dotIndex];
					}
				}, 200);

				while (true) {
					const { done, value } = await reader.read();
					if (done) break;

					buffer += decoder.decode(value, { stream: true });
					const lines = buffer.split("\n");
					buffer = lines.pop() || "";

					for (const rawLine of lines) {
						const line = rawLine.trim();
						if (!line || !line.startsWith("data: ")) continue;

						const dataStr = line.slice(6).trim();
						if (dataStr === "[DONE]") continue;

						try {
							const parsed = JSON.parse(dataStr);

							// Determine the event type
							let eventType = parsed.type || null;

							if (!eventType) {
									if (parsed.metrics) {
											eventType = "metrics";
									} else if (parsed.error) {
											eventType = "error";
									} else if (parsed.content !== undefined) {
											eventType = "content";
									} else {
											continue;
									}
							}

							switch (eventType) {
								case "thinking":
									if (thinkingAnimationInterval) {
										clearInterval(thinkingAnimationInterval);
										thinkingAnimationInterval = null;
									}

									const thinkingContent = parsed.content || "";
									if (thinkingContent.trim() && !hasThinking) {
										hasThinking = true;
										assistantMsgDiv.innerHTML = `<div class="text-xs text-sky-400/70 flex items-center gap-2">
                      <i data-lucide="brain" class="w-3 h-3"></i>
                      <span>Processing...</span>
                    </div>`;
										lucide.createIcons();
									}
									break;

								case "content":
									let contentChunk = parsed.content || "";
									if (contentChunk) {
										hasReceivedContent = true;

										if (thinkingAnimationInterval) {
											clearInterval(thinkingAnimationInterval);
											thinkingAnimationInterval = null;
										}

										if (hasThinking) {
											hasThinking = false;
										}

										// Unescape the content
										contentChunk = unescapeHtmlEntities(contentChunk);

										// Add to raw buffer
										rawBuffer += contentChunk;

										// Check if we need to detect the start of suggestions
										// Look for "<suggestions>" in the buffer
										const openTagIndex = rawBuffer.indexOf("<suggestions>");
										const closeTagIndex = rawBuffer.indexOf("</suggestions>");

										if (!isInSuggestions && openTagIndex !== -1) {
											// Found the start of suggestions
											isInSuggestions = true;

											// Everything before the open tag goes to display
											displayContent += rawBuffer.substring(0, openTagIndex);

											// Everything after the open tag goes to suggestions buffer
											let remaining = rawBuffer.substring(openTagIndex + 13); // +13 for "<suggestions>"

											// Check if we also have the closing tag in the same buffer
											const closeTagInRemaining =
												remaining.indexOf("</suggestions>");
											if (closeTagInRemaining !== -1) {
												// Both tags are in the buffer
												suggestionsBuffer += remaining.substring(
													0,
													closeTagInRemaining,
												);
												displayContent += remaining.substring(
													closeTagInRemaining + 14,
												); // +14 for "</suggestions>"
												isInSuggestions = false;
												rawBuffer = "";
											} else {
												suggestionsBuffer += remaining;
												rawBuffer = "";
											}
										} else if (isInSuggestions) {
											// We're inside suggestions
											const closeTagIndexLocal =
												rawBuffer.indexOf("</suggestions>");
											if (closeTagIndexLocal !== -1) {
												// Found the closing tag
												suggestionsBuffer += rawBuffer.substring(
													0,
													closeTagIndexLocal,
												);
												displayContent += rawBuffer.substring(
													closeTagIndexLocal + 14,
												);
												isInSuggestions = false;
												rawBuffer = "";
											} else {
												suggestionsBuffer += rawBuffer;
												rawBuffer = "";
											}
										} else {
											// Regular content before suggestions start
											displayContent += rawBuffer;
											rawBuffer = "";
										}

										// Update the display
										const cleanText = displayContent.split("<suggestions>")[0];
										if (cleanText) {
											const protectedStreamText = protectMathUnderscores(cleanText);
											const streamHtml = marked.parse(protectedStreamText);
											const streamSanitized = DOMPurify.sanitize(streamHtml);
											assistantMsgDiv.innerHTML = restoreMathUnderscores(streamSanitized);
										}
										scrollToBottom();
									}
									break;

								case "metrics":
									try {
										const metrics =
											typeof parsed.metrics === "string"
												? JSON.parse(parsed.metrics)
												: parsed.metrics;
										document.getElementById("token-counter").textContent =
											`Tokens — Prompt: ${metrics.prompt_tokens || 0} | Completion: ${metrics.completion_tokens || 0}`;
									} catch (e) {
										console.warn("Failed to parse metrics:", e);
									}
									break;

								case "done":
									break;

								case "error":
									console.error("Stream error:", parsed.error);
									if (thinkingAnimationInterval) {
										clearInterval(thinkingAnimationInterval);
										thinkingAnimationInterval = null;
									}
									assistantMsgDiv.innerHTML = `<span class="text-rose-400 text-xs flex items-center gap-1.5">
                    <i data-lucide="alert-circle" class="w-4 h-4"></i> ${parsed.error}
                  </span>`;
									lucide.createIcons();
									break;
							}
						} catch (e) {
							console.warn("Failed to parse stream data:", e, "Raw:", dataStr);
						}
					}
				}

				if (thinkingAnimationInterval) {
					clearInterval(thinkingAnimationInterval);
					thinkingAnimationInterval = null;
				}

				// Handle any remaining buffer
				if (rawBuffer) {
					if (isInSuggestions) {
						suggestionsBuffer += rawBuffer;
					} else {
						displayContent += rawBuffer;
					}
				}

				// Reconstruct the full content
				if (displayContent.trim() || suggestionsBuffer.trim()) {
					const fullContent =
						displayContent +
						(suggestionsBuffer
							? `<suggestions>${suggestionsBuffer}</suggestions>`
							: "");

					if (fullContent.trim()) {
						chatHistory.push({
							role: "assistant",
							content: fullContent,
						});
						assistantMsgDiv.innerHTML = "";
						renderAssistantMessage(assistantMsgDiv, fullContent, text);
						if (window.MathJax && window.MathJax.typesetPromise) {
							MathJax.typesetPromise([assistantMsgDiv]).catch((err) =>
								console.warn("MathJax error:", err),
							);
						}
					}
				} else if (!hasReceivedContent) {
					assistantMsgDiv.innerHTML = `<span class="text-amber-400 text-xs flex items-center gap-1.5">
            <i data-lucide="info" class="w-4 h-4"></i> No response received from the model.
          </span>`;
					lucide.createIcons();
				}
			} catch (err) {
				console.error("Fetch error:", err);
				if (thinkingAnimationInterval) {
					clearInterval(thinkingAnimationInterval);
					thinkingAnimationInterval = null;
				}
				assistantMsgDiv.innerHTML = `<span class="text-rose-400 text-xs flex items-center gap-1.5">
          <i data-lucide="alert-circle" class="w-4 h-4"></i> Connection error: ${err.message}
        </span>`;
				lucide.createIcons();
			} finally {
				inputField.disabled = false;
				sendBtn.disabled = false;
				inputField.focus();
			}
		});

		function appendMessage(role, text) {
			const container = document.getElementById("chat-container");
			const wrapper = document.createElement("div");
			wrapper.className = `flex w-full ${role === "user" ? "justify-end" : "justify-start"} mb-4`;

			const bubble = document.createElement("div");

			if (role === "user") {
				bubble.className =
					"max-w-[80%] rounded-2xl px-4 py-3 bg-sky-600 text-white text-sm shadow-md leading-relaxed whitespace-pre-wrap";
				bubble.textContent = text;
			} else {
				bubble.className =
					"max-w-[85%] sm:max-w-[80%] rounded-2xl px-5 py-4 bg-slate-900 border border-slate-800 text-slate-200 text-sm shadow-xl leading-relaxed prose prose-invert";
				const protectedText = protectMathUnderscores(text);
				const parsedHtml = marked.parse(protectedText);
				const sanitizedHtml = DOMPurify.sanitize(parsedHtml);
				bubble.innerHTML = restoreMathUnderscores(sanitizedHtml);
				applyAutoDirection(bubble);
				applyHighlighting(bubble);
				if (window.MathJax && window.MathJax.typesetPromise) {
					MathJax.typesetPromise([bubble]).catch(() => {});
				}
			}

			wrapper.appendChild(bubble);
			container.appendChild(wrapper);
			scrollToBottom();
			return bubble;
		}

		function parseMessageContent(rawText, userPrompt = "") {
			const regex = /<suggestions>([\s\S]*?)<\/suggestions>/;
			const match = rawText.match(regex);
			const visibleText = rawText.replace(regex, "").trim();
			let suggestions = [];

			if (match && match[1]) {
				try {
					let rawJson = match[1].trim();
					console.log("🔍 Raw suggestions JSON:", rawJson);

					// Remove markdown code blocks if present
					rawJson = rawJson
						.replace(/^```(?:json)?\s*/i, "")
						.replace(/\s*```$/, "")
						.trim();

					// Check if it's already a valid JSON array
					if (rawJson.startsWith("[") && rawJson.endsWith("]")) {
						suggestions = JSON.parse(rawJson);
					} else {
						// Try to parse as a single object first
						try {
							const singleObj = JSON.parse(rawJson);
							suggestions = [singleObj];
						} catch (e) {
							// If single object fails, try to split multiple objects
							// This handles the case: {"label": "..."} {"label": "..."}
							const objectMatches = rawJson.match(
								/\{[^{}]*(?:\{[^{}]*\}[^{}]*)*\}/g,
							);

							if (objectMatches && objectMatches.length > 0) {
								suggestions = objectMatches
									.map((objStr) => {
										try {
											return JSON.parse(objStr);
										} catch (e) {
											console.warn(
												"Failed to parse individual object:",
												objStr,
											);
											return null;
										}
									})
									.filter((obj) => obj !== null);
							} else {
								// Try to find array pattern
								const arrayMatch = rawJson.match(/\[[\s\S]*\]/);
								if (arrayMatch) {
									suggestions = JSON.parse(arrayMatch[0]);
								} else {
									// Try to parse as is
									suggestions = JSON.parse(rawJson);
									if (!Array.isArray(suggestions)) {
										suggestions = [suggestions];
									}
								}
							}
						}
					}

					// Ensure we have an array
					if (!Array.isArray(suggestions)) {
						suggestions = [suggestions];
					}

					// Filter out invalid items and ensure each has label/prompt
					suggestions = suggestions.filter(
						(item) =>
							item && typeof item === "object" && (item.label || item.prompt),
					);

					console.log("✅ Parsed suggestions:", suggestions);
				} catch (e) {
					console.warn("⚠️ Failed to parse suggestions:", e);
					// console.warn("Raw suggestions JSON:", rawJson);
					suggestions = [];
				}
			}

			return { visibleText, suggestions };
		}

		function renderAssistantMessage(
			bubbleContainer,
			fullResponseText,
			userPromptText = "",
		) {
			const { visibleText, suggestions } = parseMessageContent(
				fullResponseText,
				userPromptText,
			);

			// Clear the bubble and render the visible text
			console.log('Visible text to parse:', JSON.stringify(visibleText));
			const protectedText = protectMathUnderscores(visibleText);
			const parsedHtml = marked.parse(protectedText);
			const sanitizedHtml = DOMPurify.sanitize(parsedHtml);
			bubbleContainer.innerHTML = restoreMathUnderscores(sanitizedHtml);
			applyAutoDirection(bubbleContainer);
			applyHighlighting(bubbleContainer);
			if (window.MathJax && window.MathJax.typesetPromise) {
				MathJax.typesetPromise([bubbleContainer]).catch(() => {});
			}

			console.log("Rendering suggestions:", suggestions);

			if (suggestions && suggestions.length > 0) {
				const chipContainer = document.createElement("div");
				chipContainer.className =
					"flex flex-wrap gap-2 mt-4 pt-3 border-t border-slate-800/80";

				suggestions.forEach((item, index) => {
					// Handle both formats: {label, prompt} or {label, prompt} with different keys
					const label =
						item.label || item.title || item.text || `Option ${index + 1}`;
					const prompt = item.prompt || item.question || item.query || label;

					const button = document.createElement("button");
					button.className =
						"text-xs bg-slate-800/80 hover:bg-sky-600/20 hover:border-sky-500/50 text-slate-300 hover:text-sky-300 border border-slate-700/60 px-3 py-1.5 rounded-xl transition flex items-center gap-1.5 cursor-pointer shadow-sm text-start";
					button.innerHTML = `<i data-lucide="sparkles" class="w-3 h-3 text-sky-400 shrink-0"></i> <span>${label}</span>`;

					button.onclick = () => {
						const inputField = document.getElementById("user-input");
						inputField.value = prompt;
						document
							.getElementById("input-form")
							.dispatchEvent(new Event("submit"));
					};

					chipContainer.appendChild(button);
				});

				bubbleContainer.appendChild(chipContainer);
				lucide.createIcons();
			} else {
				console.log("No suggestions to render");
			}
			setTimeout(scrollToBottom, 50);
		}

		function scrollToBottom() {
			const mainContainer = document.querySelector("main");
			if (mainContainer) {
				mainContainer.scrollTop = mainContainer.scrollHeight;
			}
		}
	</script>
</Layout>
