---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Capabilities from '../../components/Capabilities.astro'; // Renamed from Features to reflect Fast/Pro/Deep Research
import SecurityArchitecture from '../../components/SecurityArchitecture.astro'; // New component for ZK/ECIES
import Pricing from '../../components/Pricing.astro';
import AppTeaser from '../../components/AppTeaser.astro'; // New mobile app component
import Footer from '../../components/Footer.astro';
import AuthModal from '../../components/AuthModal.astro';
import { languages } from '../../i18n/utils';
import TheebanShowcase from '../../components/TheebanShowcase.astro';
import MaasDeployerTeaser from '../../components/MaasDeployerTeaser.astro';
import ApiDevelopers from '../../components/ApiDevelopers.astro';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
---

<Layout title="DCP | AI Infrastructure & Zero-Knowledge Chat" lang="en">
  <Header />
  <main class="flex-1 overflow-x-hidden">
    <Hero />
    <TheebanShowcase /> 
    <MaasDeployerTeaser />
    <ApiDevelopers />
    <SecurityArchitecture />
  </main>
  <Footer />
  <AuthModal />
</Layout>