---
import Layout from "../../layouts/Layout.astro";
import Workspace from "../../components/workspace/Workspace.svelte";
import { getLangFromUrl, useTranslations, languages } from "../../i18n/utils";

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Server-side translation bundle passed down as props
const i18n = {
  backHome: t("chat.backHome"),
  headerTitle: t("chat.headerTitle"),
  cacheStatus: t("chat.cacheStatus"),
  reset: t("chat.reset"),
  welcomeTitle: t("chat.welcomeTitle"),
  welcomeDesc: t("chat.welcomeDesc"),
  placeholder: t("chat.placeholder"),
  shiftEnter: t("chat.shiftEnter"),
  tokenContext: t("chat.tokenContext"),
};
---

<Layout title="DCP Cloud | Workspace">
  <script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"></script>

  <Workspace client:load {lang} {i18n} />
</Layout>