---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AuthModal from '../../components/AuthModal.astro';
import TheebanPricing from '../../components/TheebanPricing.astro'; // The component we just built
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// This ensures Astro generates both /en/theeban and /ar/theeban
export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}
---

<Layout title="Theeban | Secure AI Chat for Saudi Enterprise" lang={lang}>
  <Header />
  
  <main class="flex-1 overflow-x-hidden bg-zinc-950 text-white">
    
    <!-- Hero Section -->
    <section class="relative pt-24 pb-20 lg:pt-32 lg:pb-28 overflow-hidden border-b border-zinc-800/50">
      <div class="absolute inset-0 bg-gradient-to-b from-emerald-900/10 to-transparent"></div>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-sm font-medium mb-8 border border-emerald-500/20">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
          {t('theeban.hero.badge')}
        </div>
        
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-8">
          {t('theeban.hero.title')}
        </h1>
        
        <p class="mt-4 text-xl text-zinc-400 max-w-3xl mx-auto mb-10 leading-relaxed">
          {t('theeban.hero.subtitle')}
        </p>
        
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-16">
          <a href={`/${lang}/workspace`} class="px-8 py-3 rounded-lg bg-emerald-600 text-white font-semibold hover:bg-emerald-500 transition-colors shadow-lg shadow-emerald-500/20">
            {t('theeban.hero.cta_primary')}
          </a>
          <a href="#pricing" class="px-8 py-3 rounded-lg bg-zinc-800 text-white font-semibold hover:bg-zinc-700 border border-zinc-700 transition-colors">
            {t('theeban.hero.cta_secondary')}
          </a>
        </div>

        <!-- Hero App Screenshot -->
        <div class="relative max-w-5xl mx-auto group">
          <div class="absolute -inset-1 bg-gradient-to-r from-emerald-500/30 to-cyan-500/30 rounded-2xl blur-lg opacity-50 group-hover:opacity-80 transition duration-1000"></div>
          <div class="relative rounded-xl bg-zinc-900 ring-1 ring-zinc-800 shadow-2xl overflow-hidden p-2">
            <div class="absolute inset-0 bg-gradient-to-tr from-emerald-500/5 to-transparent pointer-events-none"></div>
            <!-- Replace with an awesome screenshot of the chat interface showing a Saudi specific tool in action -->
            <img src="/images/theeban-hero-ui.png" alt="Theeban Secure Chat Interface" class="w-full h-auto rounded-lg border border-zinc-800/50" />
          </div>
        </div>
      </div>
    </section>

    <!-- ZKS Trust Pillar -->
    <section class="py-20 bg-[#0a0a0a]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-16">{t('theeban.trust.title')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50">
            <div class="w-12 h-12 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-400 mb-6 mx-auto">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">{t('theeban.trust.f1.title')}</h3>
            <p class="text-zinc-400 leading-relaxed">{t('theeban.trust.f1.desc')}</p>
          </div>
          <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50">
            <div class="w-12 h-12 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-400 mb-6 mx-auto">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">{t('theeban.trust.f2.title')}</h3>
            <p class="text-zinc-400 leading-relaxed">{t('theeban.trust.f2.desc')}</p>
          </div>
          <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50">
            <div class="w-12 h-12 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-400 mb-6 mx-auto">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">{t('theeban.trust.f3.title')}</h3>
            <p class="text-zinc-400 leading-relaxed">{t('theeban.trust.f3.desc')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Saudi Tooling -->
    <section class="py-24 bg-zinc-950 border-t border-zinc-800/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:flex lg:items-center lg:justify-between mb-16">
          <div class="max-w-2xl text-start">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 text-sm font-medium mb-4">
              {t('theeban.tools.badge')}
            </div>
            <h2 class="text-3xl md:text-4xl font-bold">{t('theeban.tools.title')}</h2>
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Tool 1 -->
          <div class="flex gap-4 p-6 rounded-2xl bg-zinc-900 border border-zinc-800">
            <div class="mt-1 flex-shrink-0 text-emerald-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-white mb-2">{t('theeban.tools.f1.title')}</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">{t('theeban.tools.f1.desc')}</p>
            </div>
          </div>
          <!-- Tool 2 -->
          <div class="flex gap-4 p-6 rounded-2xl bg-zinc-900 border border-zinc-800">
            <div class="mt-1 flex-shrink-0 text-emerald-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-white mb-2">{t('theeban.tools.f2.title')}</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">{t('theeban.tools.f2.desc')}</p>
            </div>
          </div>
          <!-- Tool 3 -->
          <div class="flex gap-4 p-6 rounded-2xl bg-zinc-900 border border-zinc-800">
            <div class="mt-1 flex-shrink-0 text-emerald-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-white mb-2">{t('theeban.tools.f3.title')}</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">{t('theeban.tools.f3.desc')}</p>
            </div>
          </div>
          <!-- Tool 4 -->
          <div class="flex gap-4 p-6 rounded-2xl bg-zinc-900 border border-zinc-800">
            <div class="mt-1 flex-shrink-0 text-emerald-400">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-white mb-2">{t('theeban.tools.f4.title')}</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">{t('theeban.tools.f4.desc')}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Intelligence Engine (Models) -->
    <section class="py-24 bg-[#0a0a0a] border-t border-zinc-800/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 text-sm font-medium mb-4">
          {t('theeban.models.badge')}
        </div>
        <h2 class="text-3xl md:text-4xl font-bold mb-16">{t('theeban.models.title')}</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-start">
          <div class="p-6 rounded-xl bg-zinc-900 border border-zinc-800">
            <div class="text-2xl mb-4">⚙️</div>
            <h3 class="text-xl font-bold text-white mb-2">{t('theeban.models.fast.title')}</h3>
            <p class="text-zinc-400 text-sm">{t('theeban.models.fast.desc')}</p>
          </div>
          <div class="p-6 rounded-xl bg-zinc-900 border border-emerald-500/30 relative">
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-emerald-500 to-transparent"></div>
            <div class="text-2xl mb-4">🧠</div>
            <h3 class="text-xl font-bold text-white mb-2">{t('theeban.models.pro.title')}</h3>
            <p class="text-zinc-400 text-sm">{t('theeban.models.pro.desc')}</p>
          </div>
          <div class="p-6 rounded-xl bg-zinc-900 border border-zinc-800">
            <div class="text-2xl mb-4">🔬</div>
            <h3 class="text-xl font-bold text-white mb-2">{t('theeban.models.deep.title')}</h3>
            <p class="text-zinc-400 text-sm">{t('theeban.models.deep.desc')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section Hook -->
    <div id="pricing">
      <TheebanPricing />
    </div>

  </main>
  
  <Footer />
  <AuthModal />
</Layout>