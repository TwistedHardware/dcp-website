---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } }
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`DCP Cloud | ${t('nav.security')}`}>
  <Header />
  
  <main class="min-h-screen bg-zinc-50 dark:bg-zinc-950 pt-20 pb-24">
    <!-- Hero Section -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-24">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-sm font-semibold mb-6">
        <Icon name="lucide:shield-check" class="w-4 h-4" />
        Zero-Knowledge Architecture
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 dark:text-white mb-6">
        {t('sec.hero.title')}
      </h1>
      <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400">
        {t('sec.hero.subtitle')}
      </p>
    </section>

    <!-- The Cryptographic Flow (4 Steps) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-12 text-center">{t('sec.flow.title')}</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Step 1 -->
        <div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm relative">
          <div class="w-12 h-12 bg-indigo-500/10 rounded-xl flex items-center justify-center mb-6">
            <Icon name="lucide:key" class="w-6 h-6 text-indigo-500" />
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-3">{t('sec.flow.step1.title')}</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">
            {t('sec.flow.step1.desc')}
          </p>
        </div>

        <!-- Step 2 -->
        <div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm relative">
          <div class="w-12 h-12 bg-sky-500/10 rounded-xl flex items-center justify-center mb-6">
            <Icon name="lucide:lock" class="w-6 h-6 text-sky-500" />
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-3">{t('sec.flow.step2.title')}</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">
            {t('sec.flow.step2.desc')}
          </p>
        </div>

        <!-- Step 3 -->
        <div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm relative">
          <div class="w-12 h-12 bg-purple-500/10 rounded-xl flex items-center justify-center mb-6">
            <Icon name="lucide:cpu" class="w-6 h-6 text-purple-500" />
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-3">{t('sec.flow.step3.title')}</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">
            {t('sec.flow.step3.desc')}
          </p>
        </div>

        <!-- Step 4 -->
        <div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm relative">
          <div class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center mb-6">
            <Icon name="lucide:trash-2" class="w-6 h-6 text-emerald-500" />
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-3">{t('sec.flow.step4.title')}</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed">
            {t('sec.flow.step4.desc')}
          </p>
        </div>
      </div>
    </section>

    <!-- Identity & Residency (2 Columns) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Passkeys -->
        <div class="bg-zinc-900 p-10 rounded-3xl border border-zinc-800 flex flex-col justify-center">
          <div class="flex items-center gap-4 mb-6">
            <div class="p-3 bg-indigo-500/20 rounded-xl">
              <Icon name="lucide:fingerprint" class="w-7 h-7 text-indigo-400" />
            </div>
            <h3 class="text-2xl font-bold text-white">{t('sec.identity.title')}</h3>
          </div>
          <p class="text-zinc-400 leading-relaxed text-lg">
            {t('sec.identity.desc')}
          </p>
        </div>

        <!-- Data Residency -->
        <div class="bg-zinc-50 dark:bg-zinc-900 p-10 rounded-3xl border border-zinc-200 dark:border-zinc-800 flex flex-col justify-center">
          <div class="flex items-center gap-4 mb-6">
            <div class="p-3 bg-emerald-500/20 rounded-xl">
              <Icon name="lucide:map-pin" class="w-7 h-7 text-emerald-500 dark:text-emerald-400" />
            </div>
            <h3 class="text-2xl font-bold text-zinc-900 dark:text-white">{t('sec.residency.title')}</h3>
          </div>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed text-lg">
            {t('sec.residency.desc')}
          </p>
        </div>
      </div>
    </section>

    <!-- No Training Banner -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-zinc-900 via-zinc-800 to-zinc-900 p-1 rounded-3xl">
        <div class="bg-zinc-950 rounded-[22px] p-8 md:p-12 text-center border border-zinc-800/50">
          <Icon name="lucide:database-zap" class="w-12 h-12 text-rose-500 mx-auto mb-6" />
          <h2 class="text-3xl font-bold text-white mb-4">{t('sec.notrain.title')}</h2>
          <p class="text-lg text-zinc-400 max-w-2xl mx-auto">
            {t('sec.notrain.desc')}
          </p>
        </div>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>