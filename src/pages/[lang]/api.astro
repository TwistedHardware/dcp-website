---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AuthModal from '../../components/AuthModal.astro';
import SaudiRiyal from '../../components/SaudiRiyal.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}

const basePrice = 7.5;
---

<Layout title="API | Serverless AI Endpoints" lang={lang}>
  <Header />
  
  <main class="flex-1 overflow-x-hidden bg-zinc-950 text-white">
    
    <!-- Hero Section -->
    <section class="relative pt-24 pb-20 lg:pt-32 lg:pb-28 overflow-hidden border-b border-zinc-800/50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 text-sm font-medium mb-8 border border-cyan-500/20">
          <span class="flex h-2 w-2 rounded-full bg-cyan-500"></span>
          {t('api.hero.badge')}
        </div>
        
        <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-8">
          {t('api.hero.title')}
        </h1>
        
        <p class="mt-4 text-xl text-zinc-400 max-w-3xl mx-auto mb-10 leading-relaxed">
          {t('api.hero.subtitle')}
        </p>
        
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-16">
          <a href={`/${lang}/workspace`} class="px-8 py-3 rounded-lg bg-cyan-600 text-white font-semibold hover:bg-cyan-500 transition-colors shadow-lg shadow-cyan-500/20">
            {t('api.hero.cta_primary')}
          </a>
          <a href={`/${lang}/docs`} class="px-8 py-3 rounded-lg bg-zinc-800 text-white font-semibold hover:bg-zinc-700 border border-zinc-700 transition-colors">
            {t('api.hero.cta_secondary')}
          </a>
        </div>

        <!-- Terminal cURL Snippet -->
        <div class="relative max-w-4xl mx-auto text-start">
          <div class="relative rounded-xl bg-[#0d1117] ring-1 ring-zinc-800 shadow-2xl overflow-hidden font-mono text-sm">
            <div class="flex items-center justify-between border-b border-zinc-800 bg-zinc-900/50 px-4 py-3">
              <div class="flex items-center gap-2">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                  <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                </div>
                <div class="text-xs text-zinc-500 ml-4">terminal</div>
              </div>
              <a href={`/${lang}/docs`} class="text-xs text-cyan-400 hover:text-cyan-300 transition-colors">View full docs &rarr;</a>
            </div>
            
            <div class="p-6 overflow-x-auto text-zinc-300 leading-relaxed">
<pre><code><span class="text-pink-400">curl</span> <span class="text-green-400">https://api.dcp.sa/v1/chat/completions</span> \
  <span class="text-zinc-500">-H</span> <span class="text-green-400">"Content-Type: application/json"</span> \
  <span class="text-zinc-500">-H</span> <span class="text-green-400">"Authorization: Bearer dcp_your_api_key_here"</span> \
  <span class="text-zinc-500">-d</span> <span class="text-green-400">'&#123;
    "model": "dcp/pro",
    "messages": [
      &#123;"role": "system", "content": "You are a helpful assistant."&#125;,
      &#123;"role": "user", "content": "What's the meaning of life?"&#125;
    ]
  &#125;'</span></code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Developer Features -->
    <section class="py-20 bg-[#0a0a0a]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50">
            <h3 class="text-xl font-semibold mb-3 text-white">{t('api.features.f1.title')}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{t('api.features.f1.desc')}</p>
          </div>
          <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50">
            <h3 class="text-xl font-semibold mb-3 text-white">{t('api.features.f2.title')}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{t('api.features.f2.desc')}</p>
          </div>
          <div class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50">
            <h3 class="text-xl font-semibold mb-3 text-white">{t('api.features.f3.title')}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{t('api.features.f3.desc')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Token Economics -->
    <section class="py-24 bg-zinc-950 border-t border-zinc-800/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 text-sm font-medium mb-4">
            {t('api.pricing.badge')}
          </div>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">{t('api.pricing.title')}</h2>
          <p class="text-lg text-zinc-400">{t('api.pricing.subtitle')}</p>
        </div>

        <!-- Base Price Highlight -->
        <div class="flex flex-col items-center justify-center p-8 rounded-2xl bg-zinc-900 border border-cyan-500/30 mb-8 relative">
          <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-cyan-500 to-transparent"></div>
          <span class="text-zinc-400 font-medium mb-2">{t('api.pricing.base_label')}</span>
          <div class="flex items-baseline gap-2">
            <span class="text-5xl font-bold text-white">{basePrice.toFixed(2)}</span>
            <SaudiRiyal class="text-3xl text-cyan-400 font-bold ml-1 mr-2" />
            <span class="text-lg text-zinc-500">{t('api.pricing.base_per_m')}</span>
          </div>
        </div>

        <!-- Multipliers Table -->
        <div class="rounded-xl border border-zinc-800 bg-zinc-900/50 overflow-hidden">
          <table class="w-full text-left text-sm text-zinc-300">
            <thead class="bg-zinc-800/50 text-zinc-400 uppercase text-xs font-semibold">
              <tr>
                <th class="px-6 py-4 border-b border-zinc-800">Resource</th>
                <th class="px-6 py-4 border-b border-zinc-800 text-right">Multiplier</th>
                <th class="px-6 py-4 border-b border-zinc-800 text-right">Final Rate</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800">
              <tr class="hover:bg-zinc-800/30 transition">
                <td class="px-6 py-4 font-medium text-white">{t('api.pricing.m_fast')}</td>
                <td class="px-6 py-4 text-right font-mono text-cyan-400">0.2x</td>
                <td class="px-6 py-4 text-right font-mono text-zinc-400">{(basePrice * 0.2).toFixed(2)} <SaudiRiyal class="text-lg" /></td>
              </tr>
              <tr class="hover:bg-zinc-800/30 transition">
                <td class="px-6 py-4 font-medium text-white">{t('api.pricing.m_pro')}</td>
                <td class="px-6 py-4 text-right font-mono text-cyan-400">1.0x</td>
                <td class="px-6 py-4 text-right font-mono text-zinc-400">{(basePrice * 1.0).toFixed(2)} <SaudiRiyal class="text-lg" /></td>
              </tr>
              <tr class="hover:bg-zinc-800/30 transition">
                <td class="px-6 py-4 font-medium text-white">{t('api.pricing.m_deep')}</td>
                <td class="px-6 py-4 text-right font-mono text-cyan-400">1.2x</td>
                <td class="px-6 py-4 text-right font-mono text-zinc-400">{(basePrice * 1.2).toFixed(2)} <SaudiRiyal class="text-lg" /></td>
              </tr>
              <tr class="hover:bg-zinc-800/30 transition bg-zinc-800/20">
                <td class="px-6 py-4 font-medium text-white">{t('api.pricing.m_output')}</td>
                <td class="px-6 py-4 text-right font-mono text-purple-400">2.0x</td>
                <td class="px-6 py-4 text-right font-mono text-zinc-400">{(basePrice * 2.0).toFixed(2)} <SaudiRiyal class="text-lg" /></td>
              </tr>
              <tr class="hover:bg-zinc-800/30 transition border-t-2 border-zinc-700 bg-emerald-900/10">
                <td class="px-6 py-4 font-medium text-emerald-400 flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  {t('api.pricing.m_cache')}
                </td>
                <td class="px-6 py-4 text-right font-mono text-emerald-400">0.33x</td>
                <td class="px-6 py-4 text-right font-mono text-emerald-500">{(basePrice * 0.33).toFixed(2)} <SaudiRiyal class="text-lg" /></td>
              </tr>
            </tbody>
          </table>
        </div>
        
      </div>
    </section>

  </main>
  
  <Footer />
  <AuthModal />
</Layout>