---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AuthModal from '../../components/AuthModal.astro';
import SaudiRiyal from '../../components/SaudiRiyal.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ar' } },
  ];
}
---

<Layout title="MaaS | Dedicated Model Deployments" lang={lang}>
  <Header />
  
  <main class="flex-1 overflow-x-hidden bg-zinc-950 text-white">
    
    <!-- Hero Section -->
    <section class="relative pt-24 pb-20 lg:pt-32 lg:pb-28 overflow-hidden border-b border-zinc-800/50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 text-purple-400 text-sm font-medium mb-8 border border-purple-500/20">
          <span class="flex h-2 w-2 rounded-full bg-purple-500"></span>
          {t('maas.hero.badge')}
        </div>
        
        <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight mb-8">
          {t('maas.hero.title')}
        </h1>
        
        <p class="mt-4 text-xl text-zinc-400 max-w-3xl mx-auto mb-10 leading-relaxed">
          {t('maas.hero.subtitle')}
        </p>
        
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-16">
          <a href={`/${lang}/workspace`} class="px-8 py-3 rounded-lg bg-purple-600 text-white font-semibold hover:bg-purple-500 transition-colors shadow-lg shadow-purple-500/20">
            {t('maas.hero.cta_primary')}
          </a>
          <a href="#billing-timeline" class="px-8 py-3 rounded-lg bg-zinc-800 text-white font-semibold hover:bg-zinc-700 border border-zinc-700 transition-colors">
            {t('maas.hero.cta_secondary')}
          </a>
        </div>

        <!-- Hero UI Card (Visual Mockup of the 1-Click Deployer) -->
        <div class="relative max-w-3xl mx-auto text-start">
          <div class="absolute -inset-1 bg-gradient-to-r from-purple-500/20 to-indigo-500/20 rounded-2xl blur-lg opacity-75"></div>
          <div class="relative rounded-xl bg-[#0d1117] ring-1 ring-zinc-800 shadow-2xl p-6 sm:p-8">
            <div class="flex items-center justify-between pb-4 border-b border-zinc-800 mb-6">
              <span class="text-xs font-mono uppercase tracking-wider text-purple-400">1-Click Hugging Face Deploy</span>
              <span class="text-xs font-mono text-zinc-500">vLLM Engine Ready</span>
            </div>
            
            <div class="space-y-4">
              <div>
                <label class="block text-xs font-mono text-zinc-400 mb-2">HUGGING FACE MODEL REPO / URL</label>
                <div class="relative">
                  <input 
                    type="text" 
                    readonly 
                    value="zai-org/GLM-5.3-Flash" 
                    class="w-full bg-zinc-900 border border-zinc-700 rounded-lg px-4 py-3 text-sm font-mono text-zinc-200 focus:outline-none"
                  />
                  <span class="absolute right-3 top-3 px-2 py-0.5 rounded text-[10px] font-mono bg-zinc-800 text-zinc-400 border border-zinc-700">HF Private Token Supported</span>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-mono text-zinc-400 mb-2">
                  <span>DEDICATED VRAM ALLOCATION</span>
                  <span class="text-purple-400 font-bold">512 GB VRAM</span>
                </div>
                <!-- Segmented Bar -->
                <div class="w-full bg-zinc-800 rounded-full h-2 flex overflow-hidden">
                  <div class="bg-purple-600 h-2 w-[65%]" title="Model Weights"></div>
                  <div class="bg-purple-400 h-2 w-[25%]" title="KV Cache Allocation"></div>
                </div>
                <!-- Mini Legend -->
                <div class="flex items-center justify-between mt-2">
                  <div class="flex gap-3 text-[10px] font-mono text-zinc-500">
                     <div class="flex items-center gap-1.5">
                       <span class="w-2 h-2 rounded-sm bg-purple-600"></span> Weights (~330 GB)
                     </div>
                     <div class="flex items-center gap-1.5">
                       <span class="w-2 h-2 rounded-sm bg-purple-400"></span> KV Cache (~130 GB)
                     </div>
                  </div>
                  <span class="text-[10px] font-mono text-zinc-600">~50 GB Buffer</span>
                </div>
              </div>

              <div class="pt-4 flex items-center justify-between">
                <div>
                  <span class="text-xs text-zinc-500 block font-mono">ESTIMATED RUNTIME RATE</span>
                  <div class="flex items-baseline gap-1 text-lg font-bold text-white">
                    <span>102.40</span>
                    <SaudiRiyal class="text-lg text-purple-400" />
                    <span class="text-xs font-normal text-zinc-400">/ hour (Active only)</span>
                  </div>
                </div>
                <button class="px-6 py-2.5 rounded-lg bg-purple-600 text-white font-semibold text-sm hover:bg-purple-500 transition-colors pointer-events-none">
                  Deploy Instance
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Visual Timeline Comparison: True Active Billing vs Traditional GPUaaS -->
    <section id="billing-timeline" class="py-24 bg-[#0a0a0a] border-b border-zinc-800/50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 text-sm font-medium mb-4">
            {t('maas.billing.badge')}
          </div>
          <h2 class="text-3xl md:text-4xl font-bold mb-4">{t('maas.billing.title')}</h2>
          <p class="text-lg text-zinc-400 max-w-3xl mx-auto">{t('maas.billing.subtitle')}</p>
        </div>

        <!-- Custom Comparative SVG Timeline -->
        <div class="rounded-2xl bg-zinc-900 border border-zinc-800 p-4 sm:p-8 shadow-2xl overflow-x-auto custom-scrollbar" dir="ltr">
          <svg viewBox="0 0 800 320" class="w-full h-auto min-w-[600px] md:min-w-full font-mono select-none">
            
            <!-- Grid background lines -->
            <line x1="120" y1="40" x2="120" y2="280" stroke="#27272a" stroke-dasharray="4 4" />
            <line x1="240" y1="40" x2="240" y2="280" stroke="#27272a" stroke-dasharray="4 4" />
            <line x1="420" y1="40" x2="420" y2="280" stroke="#27272a" stroke-dasharray="4 4" />
            <line x1="700" y1="40" x2="700" y2="280" stroke="#27272a" stroke-dasharray="4 4" />

            <!-- Phase Header Markers -->
            <text x="60" y="25" fill="#71717a" font-size="12" text-anchor="middle">Provision</text>
            <text x="180" y="25" fill="#71717a" font-size="12" text-anchor="middle">SSH / Config</text>
            <text x="330" y="25" fill="#71717a" font-size="12" text-anchor="middle">Weights (~20m)</text>
            <text x="560" y="25" fill="#a1a1aa" font-size="12" text-anchor="middle" font-weight="bold">Active API Inference</text>
            <text x="750" y="25" fill="#71717a" font-size="12" text-anchor="middle">Teardown</text>

            <!-- Track 1: Traditional GPUaaS -->
            <g transform="translate(0, 80)">
              <!-- Title Moved Above the Track -->
              <text x="0" y="-12" fill="#ef4444" font-weight="bold" font-size="16" text-anchor="start">Traditional GPUaaS</text>
              
              <!-- Billed continuous bar (RED) -->
              <rect x="0" y="0" width="800" height="44" rx="8" fill="#ef4444" fill-opacity="0.15" stroke="#ef4444" stroke-width="1.5" />
              
              <!-- Internal progress lines (Matching Grid) -->
              <line x1="120" y1="0" x2="120" y2="44" stroke="#ef4444" stroke-opacity="0.4" />
              <line x1="240" y1="0" x2="240" y2="44" stroke="#ef4444" stroke-opacity="0.4" />
              <line x1="420" y1="0" x2="420" y2="44" stroke="#ef4444" stroke-opacity="0.4" />
              <line x1="700" y1="0" x2="700" y2="44" stroke="#ef4444" stroke-opacity="0.4" />

              <!-- Centered Text -->
              <text x="400" y="27" fill="#fca5a5" font-size="13" text-anchor="middle">Billed for idle setup, SSH keys, network queues &amp; cold starts</text>
              <text x="800" y="64" fill="#ef4444" font-size="12" text-anchor="end">100% of elapsed time billed</text>
            </g>

            <!-- Track 2: DCP True Active Billing -->
            <g transform="translate(0, 200)">
              <!-- Title Moved Above the Track -->
              <text x="0" y="-12" fill="#a855f7" font-weight="bold" font-size="16" text-anchor="start">DCP Dedicated MaaS</text>
              
              <!-- Free Phase 1: Setup & Downloads (GRAY/UNBILLED) -->
              <rect x="0" y="0" width="420" height="44" rx="8" fill="#27272a" stroke="#3f3f46" stroke-width="1" stroke-dasharray="4 4" />
              <text x="210" y="27" fill="#a1a1aa" font-size="13" text-anchor="middle">Downloads &amp; Setup: FREE (0.00)</text>

              <!-- Active Phase: The only billed phase (GREEN) -->
              <rect x="420" y="0" width="280" height="44" rx="8" fill="#10b981" fill-opacity="0.2" stroke="#10b981" stroke-width="2" />
              <text x="560" y="27" fill="#34d399" font-weight="bold" font-size="14" text-anchor="middle">ACTIVE (BILLED)</text>

              <!-- Free Phase 2: Pause / Eviction (GRAY/UNBILLED) -->
              <rect x="700" y="0" width="100" height="44" rx="8" fill="#27272a" stroke="#3f3f46" stroke-width="1" stroke-dasharray="4 4" />
              <text x="750" y="27" fill="#a1a1aa" font-size="13" text-anchor="middle">FREE</text>

              <!-- Subtext -->
              <text x="560" y="64" fill="#10b981" font-size="12" text-anchor="middle">Billing starts on 1st API heartbeat. Halts instantly on pause.</text>
            </g>
          </svg>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
          <div class="p-6 rounded-xl bg-zinc-900/60 border border-red-500/20">
            <h3 class="text-red-400 font-semibold mb-2">{t('maas.billing.card_traditional')}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{t('maas.billing.card_traditional_desc')}</p>
          </div>
          <div class="p-6 rounded-xl bg-zinc-900/60 border border-emerald-500/30">
            <h3 class="text-emerald-400 font-semibold mb-2">{t('maas.billing.card_dcp')}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{t('maas.billing.card_dcp_desc')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Dedicated VRAM Pillar -->
    <section class="py-20 bg-zinc-950">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 text-sm font-medium mb-4">
            {t('maas.dedicated.badge')}
          </div>
          <h2 class="text-3xl md:text-4xl font-bold">{t('maas.dedicated.title')}</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="p-6 rounded-2xl bg-zinc-900 border border-zinc-800">
            <div class="w-10 h-10 rounded-lg bg-purple-500/10 flex items-center justify-center text-purple-400 mb-6">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">{t('maas.dedicated.f1.title')}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{t('maas.dedicated.f1.desc')}</p>
          </div>
          <div class="p-6 rounded-2xl bg-zinc-900 border border-zinc-800">
            <div class="w-10 h-10 rounded-lg bg-purple-500/10 flex items-center justify-center text-purple-400 mb-6">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">{t('maas.dedicated.f2.title')}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{t('maas.dedicated.f2.desc')}</p>
          </div>
          <div class="p-6 rounded-2xl bg-zinc-900 border border-zinc-800">
            <div class="w-10 h-10 rounded-lg bg-purple-500/10 flex items-center justify-center text-purple-400 mb-6">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z" /></svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">{t('maas.dedicated.f3.title')}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{t('maas.dedicated.f3.desc')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3-Step UI Workflow: Side-by-Side Cards -->
    <section class="py-24 bg-[#0a0a0a] border-t border-zinc-800/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-20">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 text-sm font-medium mb-4">
            {t('maas.steps.badge')}
          </div>
          <h2 class="text-3xl md:text-4xl font-bold">{t('maas.steps.title')}</h2>
        </div>

        <div class="space-y-16">
          
          <!-- Step 1 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center p-8 rounded-2xl bg-zinc-900/60 border border-zinc-800">
            <div>
              <span class="text-4xl font-black text-purple-500/40 mb-4 block">{t('maas.steps.s1.step')}</span>
              <h3 class="text-2xl font-bold text-white mb-4">{t('maas.steps.s1.title')}</h3>
              <p class="text-zinc-400 leading-relaxed text-base">{t('maas.steps.s1.desc')}</p>
            </div>
            <div class="rounded-xl overflow-hidden ring-1 ring-zinc-800 bg-zinc-950 p-2 shadow-2xl">
              <!-- Replace with screenshot of Step 1 UI -->
              <img src="/images/maas-step-1-url.png" alt="MaaS Step 1: Hugging Face URL Input" class="w-full h-auto rounded-lg border border-zinc-800" />
            </div>
          </div>

          <!-- Step 2 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center p-8 rounded-2xl bg-zinc-900/60 border border-zinc-800">
            <div>
              <span class="text-4xl font-black text-purple-500/40 mb-4 block">{t('maas.steps.s2.step')}</span>
              <h3 class="text-2xl font-bold text-white mb-4">{t('maas.steps.s2.title')}</h3>
              <p class="text-zinc-400 leading-relaxed text-base">{t('maas.steps.s2.desc')}</p>
            </div>
            <div class="rounded-xl overflow-hidden ring-1 ring-zinc-800 bg-zinc-950 p-2 shadow-2xl">
              <!-- Replace with screenshot of Step 2 UI (Slider & Cost Calculator) -->
              <img src="/images/maas-step-2-vram.png" alt="MaaS Step 2: Dedicated VRAM Allocation Slider" class="w-full h-auto rounded-lg border border-zinc-800" />
            </div>
          </div>

          <!-- Step 3 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center p-8 rounded-2xl bg-zinc-900/60 border border-zinc-800">
            <div>
              <span class="text-4xl font-black text-purple-500/40 mb-4 block">{t('maas.steps.s3.step')}</span>
              <h3 class="text-2xl font-bold text-white mb-4">{t('maas.steps.s3.title')}</h3>
              <p class="text-zinc-400 leading-relaxed text-base">{t('maas.steps.s3.desc')}</p>
            </div>
            <div class="rounded-xl overflow-hidden ring-1 ring-zinc-800 bg-zinc-950 p-2 shadow-2xl">
              <!-- Replace with screenshot of Step 3 UI (Active Heartbeat & OpenAI Endpoints) -->
              <img src="/images/maas-step-3-endpoint.png" alt="MaaS Step 3: Production Endpoint and Health Status" class="w-full h-auto rounded-lg border border-zinc-800" />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Pricing Summary Card -->
    <section class="py-24 bg-zinc-950 border-t border-zinc-800/50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="rounded-2xl bg-gradient-to-b from-zinc-900 to-[#0d1117] border border-purple-500/30 p-10 sm:p-14 relative">
          <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-purple-500 to-transparent"></div>
          
          <span class="text-sm font-semibold tracking-wider uppercase text-purple-400 mb-4 block">
            {t('maas.pricing.badge')}
          </span>
          
          <div class="flex items-baseline justify-center gap-2 my-6">
            <span class="text-6xl font-extrabold text-white">{t('maas.pricing.title')}</span>
            <SaudiRiyal class="text-3xl text-purple-400 font-bold ml-1 mr-2" />
            <span class="text-xl text-zinc-400">{t('maas.pricing.unit')}</span>
          </div>

          <p class="text-zinc-400 text-base max-w-lg mx-auto mb-8">
            {t('maas.pricing.note')}
          </p>

          <a href={`/${lang}/workspace`} class="inline-block px-10 py-4 rounded-lg bg-purple-600 text-white font-semibold hover:bg-purple-500 transition-colors shadow-lg shadow-purple-500/20">
            {t('maas.pricing.cta')}
          </a>
        </div>
      </div>
    </section>

  </main>
  
  <Footer />
  <AuthModal />
</Layout>