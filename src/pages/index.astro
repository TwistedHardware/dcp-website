---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Capabilities from '../components/Capabilities.astro';
import SecurityArchitecture from '../components/SecurityArchitecture.astro';
import Pricing from '../components/Pricing.astro';
import AppTeaser from '../components/AppTeaser.astro';
import Footer from '../components/Footer.astro';
import AuthModal from '../components/AuthModal.astro';

// No getStaticPaths needed here since this isn't a dynamic route
---

<!-- Pass the default language directly to the Layout -->
<Layout title="DCP Cloud | Zero-Knowledge Enterprise AI" lang="en">
  <Header />
  
  <main class="flex-1 overflow-x-hidden">
    <Hero />
    <Capabilities />
    <SecurityArchitecture />
    <Pricing />
    <AppTeaser />
  </main>
  
  <Footer />
  
  <AuthModal />
</Layout>