---
import { Icon } from 'astro-icon/components';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const capabilities = [
  {
    id: 'fast',
    icon: 'lucide:zap',
    iconBg: 'bg-sky-500/10 dark:bg-sky-500/20',
    iconColor: 'text-sky-600 dark:text-sky-400',
    title: t('home.fast.title'),
    desc: t('home.fast.desc'),
    badge: t('home.fast.badge')
  },
  {
    id: 'pro',
    icon: 'lucide:brain',
    iconBg: 'bg-indigo-500/10 dark:bg-indigo-500/20',
    iconColor: 'text-indigo-600 dark:text-indigo-400',
    title: t('home.pro.title'),
    desc: t('home.pro.desc'),
    badge: t('home.pro.badge')
  },
  {
    id: 'deep_research',
    icon: 'lucide:microscope',
    iconBg: 'bg-purple-500/10 dark:bg-purple-500/20',
    iconColor: 'text-purple-600 dark:text-purple-400',
    title: t('home.deep.title'),
    desc: t('home.deep.desc'),
    badge: t('home.deep.badge')
  }
];
---

<section class="py-24 bg-zinc-50 dark:bg-zinc-900 border-t border-zinc-200 dark:border-zinc-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
        {t('home.section_title')} 
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400 mx-auto">
        {t('home.section_subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-start">
      {capabilities.map(cap => (
        <div class="relative flex flex-col p-8 rounded-2xl bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-start justify-between mb-6">
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${cap.iconBg}`}>
              <Icon name={cap.icon} class={`w-6 h-6 ${cap.iconColor}`} />
            </div>
            
            <span class="inline-flex items-center rounded-full bg-zinc-100 dark:bg-zinc-700 px-3 py-1 text-xs font-semibold text-zinc-800 dark:text-zinc-200">
              {cap.badge}
            </span>
          </div>
          
          <h3 class="text-xl font-semibold text-zinc-900 dark:text-white font-mono mb-2">{cap.title}</h3>
          <p class="text-zinc-600 dark:text-zinc-400 flex-1 leading-relaxed">{cap.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>