---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
// import { FingerprintPattern, Fingerprint, ScanFace, Loader2 } from '@lucide/astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<dialog id="auth-modal" class="bg-transparent m-auto backdrop:bg-zinc-950/80 backdrop:backdrop-blur-sm open:flex flex-col w-full max-w-md p-0 rounded-2xl shadow-2xl border border-zinc-800/80 opacity-0 transition-opacity duration-300 [&[open]]:opacity-100">
  <div class="bg-zinc-900 w-full p-8 rounded-2xl flex flex-col items-center text-center">
    
    <div class="w-14 h-14 rounded-2xl bg-zinc-800 border border-zinc-700 flex items-center justify-center mb-6 shadow-inner">
      <i data-lucide="fingerprint" class="w-7 h-7 text-indigo-400"></i>
      <!-- <FingerprintPatter color="5C6BC0" class="w-7 h-7 text-indigo-400"></FingerprintPattern> -->
      <!-- <ScanFace></ScanFace> -->
    </div>
    
    <h2 class="text-xl font-bold text-zinc-100 mb-2" id="modal-title"></h2>
    <p class="text-sm text-zinc-400 mb-6" id="modal-subtitle"></p>

    <!-- Dynamic Status Message -->
    <p id="auth-status" class="text-sm font-medium mb-4 hidden px-4 py-2 rounded-lg w-full"></p>

    <div class="w-full space-y-4">
      
      <!-- SIGN UP STEP 1: SSO Only -->
      <div id="signup-step1-section" class="hidden space-y-3 mb-6">
        <a href={`https://ln.tejory.io/api/auth/google/init?lang=${lang}`} class="w-full bg-white hover:bg-zinc-50 text-zinc-900 font-semibold border border-zinc-200 px-4 py-3 rounded-xl flex items-center justify-center gap-3 transition">
          <!-- <svg class="w-5 h-5" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg> -->
          <svg class="w-5 h-5" version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" xmlns:xlink="http://www.w3.org/1999/xlink" style="display: block;"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path><path fill="none" d="M0 0h48v48H0z"></path></svg>
          {t('auth.google')}
        </a>
      </div>

      <!-- SIGN UP STEP 2 OR LOGIN: Passkey Only -->
      <button id="passkey-btn" class="hidden w-full bg-indigo-500 hover:bg-indigo-400 text-white font-semibold px-4 py-3.5 rounded-xl transition shadow-lg shadow-indigo-500/20 flex items-center justify-center gap-3">
        <i id="passkey-icon" data-lucide="scan-face" class="w-5 h-5"></i>
        <span id="passkey-text"></span>
        <i data-lucide="loader-2" class="w-5 h-5 animate-spin hidden" id="passkey-loader"></i>
      </button>

      <!-- Toggle Mode Text -->
      <div id="toggle-container" class="text-xs text-zinc-400 mt-4">
        <span id="toggle-prefix"></span> 
        <button id="auth-toggle-btn" class="text-indigo-400 hover:text-indigo-300 font-medium transition ml-1"></button>
      </div>

    </div>

    <!-- Close Button -->
    <button id="close-modal" class="mt-6 text-sm text-zinc-400 hover:text-zinc-200 transition">
      {t('auth.cancel')}
    </button>
  </div>
</dialog>

<script is:inline define:vars={{ 
  lang, 
  txtLogin: t('auth.passkeyLogin'), 
  txtSignup: t('auth.passkeySignup'),
  txtTitleLogin: t('auth.title_login'),
  txtTitleSignup: t('auth.title_signup'),
  txtTitleStep2: t('auth.title_step2'),
  txtSubLogin: t('auth.subtitle_login'),
  txtSubSignup: t('auth.subtitle_signup'),
  txtSubStep2: t('auth.subtitle_step2'),
  txtNoAccount: t('auth.noAccount'),
  txtHasAccount: t('auth.hasAccount'),
  txtToggleSignUp: t('auth.signUpToggle'),
  txtToggleSignIn: t('auth.signInToggle'),
  txtSessionExpired: t('auth.sessionExpired'),
  txtWorkspace: t('auth.workspace') || 'Workspace' // Fallback just in case
}}>
  const initAuthModal = () => {
    console.log("1");

    const BASE_URL = "https://ln.tejory.io"; 
    
    // --- Check Auth State for Workspace Button ---
    const token = localStorage.getItem('token');
    const expiry = localStorage.getItem('token_expiry');
    // Check if token exists and expiry is in the future (assuming Unix timestamp in seconds)
    const isLoggedIn = token && expiry && (parseInt(expiry) > Math.floor(Date.now() / 1000));

    const loginBtns = document.querySelectorAll('#login-btn');
    
    if (isLoggedIn) {
      // User is logged in: Morph the Login button(s) into Workspace button(s)
      loginBtns.forEach(btn => {
        btn.textContent = txtWorkspace;
        btn.id = 'workspace-btn'; // Remove 'login-btn' so the modal listener ignores it
        
        // If it's an anchor tag, just update the href
        if (btn.tagName === 'A') {
          btn.href = `/${lang}/chat`;
        } 
        
        // Add click listener to route to workspace
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          window.location.href = `/${lang}/chat`;
        });
      });
    }

    // UI Elements
    const modal = document.getElementById('auth-modal');
    const closeBtn = document.getElementById('close-modal');
    const passkeyBtn = document.getElementById('passkey-btn');
    const passkeyText = document.getElementById('passkey-text');
    const passkeyIcon = document.getElementById('passkey-icon');
    const passkeyLoader = document.getElementById('passkey-loader');
    const authToggleBtn = document.getElementById('auth-toggle-btn');
    const togglePrefix = document.getElementById('toggle-prefix');
    const toggleContainer = document.getElementById('toggle-container');
    const statusMsg = document.getElementById('auth-status');
    const signupStep1Section = document.getElementById('signup-step1-section');
    const modalTitle = document.getElementById('modal-title');
    const modalSubtitle = document.getElementById('modal-subtitle');

    // Modes: 'login', 'signup_step1', 'signup_step2'
    let currentMode = localStorage.getItem('dcp_known_user') ? 'login' : 'signup_step1'; 
    let ssoSessionToken = null;

    // --- UI State Helpers ---
    const hideStatus = () => statusMsg.classList.add('hidden');

    function updateModalUIForMode() {
      hideStatus();
      
      if (currentMode === 'login') {
        modalTitle.innerText = txtTitleLogin;
        modalSubtitle.innerText = txtSubLogin;
        passkeyText.innerText = txtLogin;
        togglePrefix.innerText = txtNoAccount;
        authToggleBtn.innerText = txtToggleSignUp;
        
        signupStep1Section.classList.add('hidden');
        passkeyBtn.classList.remove('hidden');
        passkeyBtn.classList.add('flex');
        toggleContainer.classList.remove('hidden');
        
      } else if (currentMode === 'signup_step1') {
        modalTitle.innerText = txtTitleSignup;
        modalSubtitle.innerText = txtSubSignup;
        togglePrefix.innerText = txtHasAccount;
        authToggleBtn.innerText = txtToggleSignIn;
        
        signupStep1Section.classList.remove('hidden');
        passkeyBtn.classList.add('hidden');
        passkeyBtn.classList.remove('flex');
        toggleContainer.classList.remove('hidden');
        
      } else if (currentMode === 'signup_step2') {
        modalTitle.innerText = txtTitleStep2;
        modalSubtitle.innerText = txtSubStep2;
        passkeyText.innerText = txtSignup;
        
        signupStep1Section.classList.add('hidden');
        passkeyBtn.classList.remove('hidden');
        passkeyBtn.classList.add('flex');
        toggleContainer.classList.add('hidden');
      }
    }

    // --- Check for SSO Callback ---
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('setup_passkey') === 'true') {
      ssoSessionToken = urlParams.get('session_token');
      currentMode = 'signup_step2';
      updateModalUIForMode();
      openModal();
      
      window.history.replaceState({}, document.title, window.location.pathname);
    } else {
      updateModalUIForMode();
    }

    // --- Modal Controls ---
    function openModal(msg = null, isError = false) {
      if (modal) {
        modal.showModal();
        document.body.style.overflow = 'hidden';
        if (msg) showStatus(msg, isError);
      }
    }

    function closeModal() {
      if (modal) {
        modal.close();
        document.body.style.overflow = '';
        hideStatus();
      }
    }

    // Listen to all clicks on the document to capture dynamically rendered buttons
    document.addEventListener('click', (e) => {
      // If the clicked element (or its parent) has the id 'login-btn', open modal
      if (e.target.closest('#login-btn')) {
        e.preventDefault();
        openModal();
      }
    });
    
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    
    if (modal) {
      modal.addEventListener('click', (e) => {
        const rect = modal.getBoundingClientRect();
        if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
          closeModal();
        }
      });
    }

    if (authToggleBtn) {
      authToggleBtn.addEventListener('click', () => {
        if (currentMode === 'signup_step2') return;
        currentMode = currentMode === 'login' ? 'signup_step1' : 'login';
        updateModalUIForMode();
      });
    }

    const setLoader = (isLoading) => {
      passkeyBtn.disabled = isLoading;
      if (isLoading) {
        passkeyIcon.classList.add('hidden');
        passkeyLoader.classList.remove('hidden');
      } else {
        passkeyIcon.classList.remove('hidden');
        passkeyLoader.classList.add('hidden');
      }
    };

    const showStatus = (msg, isError = false) => {
      statusMsg.textContent = msg;
      statusMsg.className = `text-sm font-medium mb-4 px-4 py-2 rounded-lg w-full ${isError ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'}`;
      statusMsg.classList.remove('hidden');
    };

    const b64dec = (s) => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), c => c.charCodeAt(0));
    const b64enc = (b) => btoa(String.fromCharCode(...new Uint8Array(b))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');

    if (passkeyBtn) {
      passkeyBtn.addEventListener('click', async () => {
        setLoader(true);
        hideStatus();
        currentMode === 'login' ? await performLogin() : await performSignup();
        setLoader(false);
      });
    }

    async function performSignup() {
      try {
        const endpoint = ssoSessionToken 
          ? `${BASE_URL}/api/signup/start?session_token=${ssoSessionToken}`
          : `${BASE_URL}/api/signup/start`;

        const startRes = await fetch(endpoint);
        if (!startRes.ok) throw new Error("Could not reach auth server.");
        const data = await startRes.json();

        const pk = data.options.publicKey;
        pk.challenge = b64dec(pk.challenge);
        pk.user.id = b64dec(pk.user.id);
        if (pk.excludeCredentials) pk.excludeCredentials.forEach(c => c.id = b64dec(c.id));

        const cred = await navigator.credentials.create({ publicKey: pk });

        const body = {
          id: cred.id,
          rawId: b64enc(cred.rawId),
          type: cred.type,
          response: {
            attestationObject: b64enc(cred.response.attestationObject),
            clientDataJSON: b64enc(cred.response.clientDataJSON),
          },
        };

        const finishRes = await fetch(`${BASE_URL}/api/signup/finish?session_token=${data.sessionToken}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body)
        });
        
        if (!finishRes.ok) throw new Error(await finishRes.text());
        const res = await finishRes.json();
        
        handleSuccess(res.token, res.expiry, res.publicKey, "Registration successful!");
      } catch (err) {
        console.error(err);
        showStatus("Registration canceled or failed.", true);
      }
    }

    async function performLogin() {
      try {
        const startRes = await fetch(`${BASE_URL}/api/login/start`);
        if (!startRes.ok) throw new Error("Could not reach auth server.");
        const data = await startRes.json();

        const pk = data.options.publicKey;
        pk.challenge = b64dec(pk.challenge);
        if (pk.allowCredentials) pk.allowCredentials.forEach(c => c.id = b64dec(c.id));

        const cred = await navigator.credentials.get({ publicKey: pk });

        const body = {
          id: cred.id,
          rawId: b64enc(cred.rawId),
          type: cred.type,
          response: {
            authenticatorData: b64enc(cred.response.authenticatorData),
            clientDataJSON: b64enc(cred.response.clientDataJSON),
            signature: b64enc(cred.response.signature),
            userHandle: cred.response.userHandle ? b64enc(cred.response.userHandle) : null,
          },
        };

        const finishRes = await fetch(`${BASE_URL}/api/login/finish?session_token=${data.sessionToken}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body)
        });
        
        if (!finishRes.ok) throw new Error(await finishRes.text());
        const res = await finishRes.json();
        
        handleSuccess(res.token, res.expiry, res.publicKey, "Login successful!");
      } catch (err) {
        console.error(err);
        showStatus("Login canceled or failed.", true);
      }
    }

    function handleSuccess(token, expiry, publicKey, msg) {
      localStorage.setItem("token", token);
      localStorage.setItem("token_expiry", expiry);
      localStorage.setItem("public_key", publicKey);
      
      localStorage.setItem("dcp_known_user", "true");
      
      showStatus(msg, false);
      
      setTimeout(() => {
        window.location.href = `/${lang}/chat`;
      }, 800);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAuthModal);
  } else {
    initAuthModal();
  }
</script>