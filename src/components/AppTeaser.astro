---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-24 bg-zinc-50 dark:bg-zinc-900 border-t border-zinc-200 dark:border-zinc-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
      {t('app.title')}
    </h2>
    <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">
      {t('app.subtitle')}
    </p>
    
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-8">
      <!-- App Store Button -->
      <div class="relative group cursor-not-allowed">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-indigo-500 to-cyan-500 rounded-lg blur opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
        <button disabled class="relative flex items-center gap-3 bg-zinc-900 px-6 py-3 rounded-lg border border-zinc-700 text-white opacity-80 min-w-[200px] justify-center">
          <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.04 2.26-.7 3.59-.65 1.58.11 2.85.8 3.58 2.06-2.9 1.77-2.38 5.76.62 6.94-.65 1.63-1.5 3.09-2.87 3.82zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
          <div class="text-start">
            <div class="text-[10px] uppercase tracking-wider text-zinc-400 leading-none mb-1">{t('app.download')}</div>
            <div class="text-sm font-semibold leading-none">App Store</div>
          </div>
        </button>
        <span class="absolute -top-3 -end-3 bg-indigo-500 text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-lg z-10">
          {t('app.coming_soon')}
        </span>
      </div>

      <!-- Google Play Button -->
      <div class="relative group cursor-not-allowed">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-emerald-500 to-teal-500 rounded-lg blur opacity-20 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
        <button disabled class="relative flex items-center gap-3 bg-zinc-900 px-6 py-3 rounded-lg border border-zinc-700 text-white opacity-80 min-w-[200px] justify-center">
          <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M3.609 1.814L13.792 12 3.61 22.186a1.986 1.986 0 01-.61-1.43V3.244c0-.528.204-1.03.582-1.41a1.996 1.996 0 01.027-.02zm1.488.583l7.98 4.606L14.772 12l-1.696 1.697-7.98 4.607a1.99 1.99 0 01-1.39.26l9.39-9.39zM16.14 10.642l2.368-2.368 2.766 1.597c.563.325.91.905.91 1.536s-.347 1.21-.91 1.535l-2.766 1.597-2.368-2.368L22.184 12l-6.044-1.358z"/></svg>
          <div class="text-start">
            <div class="text-[10px] uppercase tracking-wider text-zinc-400 leading-none mb-1">{t('app.download')}</div>
            <div class="text-sm font-semibold leading-none">Google Play</div>
          </div>
        </button>
        <span class="absolute -top-3 -end-3 bg-emerald-500 text-white text-[10px] font-bold px-2.5 py-1 rounded-full shadow-lg z-10">
          {t('app.coming_soon')}
        </span>
      </div>
    </div>
  </div>
</section>