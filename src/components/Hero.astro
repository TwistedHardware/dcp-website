---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative pt-24 pb-16 px-6 max-w-5xl mx-auto text-center flex flex-col items-center">
  <!-- Decorative background glow -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-3/4 h-48 bg-sky-500/10 blur-[100px] -z-10 rounded-full pointer-events-none"></div>

  <!-- Residency Badge -->
  <div class="bg-emerald-500/10 text-emerald-400 text-xs font-medium px-3 py-1 rounded-full border border-emerald-500/20 flex items-center gap-2 mb-8">
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
    {t('hero.badge')}
  </div>

  <!-- Headlines -->
  <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-slate-100 mb-6 leading-tight">
    {t('hero.title')}
  </h1>
  <p class="text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed mb-10">
    {t('hero.subtitle')}
  </p>

  <!-- CTAs -->
  <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
    <button id="launch-workspace-btn" class="w-full sm:w-auto bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold px-6 py-3 rounded-xl transition shadow-lg shadow-sky-500/20 flex items-center justify-center gap-2">
      <i data-lucide="sparkles" class="w-5 h-5"></i>
      {t('hero.ctaPrimary')}
    </button>
    <button class="w-full sm:w-auto bg-slate-900 border border-slate-800 hover:bg-slate-800 text-slate-200 font-medium px-6 py-3 rounded-xl transition flex items-center justify-center gap-2">
      <i data-lucide="terminal" class="w-5 h-5 text-slate-400"></i>
      {t('hero.ctaSecondary')}
    </button>
  </div>
</section>

<script is:inline define:vars={{ lang }}>
  document.addEventListener('DOMContentLoaded', () => {
    const launchBtn = document.getElementById('launch-workspace-btn');
    
    launchBtn.addEventListener('click', () => {
      const token = localStorage.getItem("token");
      const expiry = localStorage.getItem("token_expiry");
      
      const isExpired = () => {
        if (!token || !expiry) return true;
        const expiryTime = !isNaN(expiry) ? 
          (String(expiry).length === 10 ? Number(expiry) * 1000 : Number(expiry)) : 
          new Date(expiry).getTime();
        return Date.now() > expiryTime;
      };

      if (!isExpired()) {
        // Logged in: Go to chat workspace
        window.location.href = `/${lang}/chat`;
      } else {
        // Logged out: Trigger the existing auth modal
        document.getElementById('auth-modal').showModal();
        document.body.style.overflow = 'hidden';
      }
    });
  });
</script>