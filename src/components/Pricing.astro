---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const plans = [
  {
    key: 'standard',
    color: 'text-slate-400',
    btn: 'bg-slate-800 hover:bg-slate-700 text-slate-200'
  },
  {
    key: 'pro',
    color: 'text-sky-400',
    btn: 'bg-sky-500 hover:bg-sky-400 text-slate-950 shadow-lg shadow-sky-500/20',
    popular: true
  },
  {
    key: 'max',
    color: 'text-indigo-400',
    btn: 'bg-slate-800 hover:bg-slate-700 text-slate-200'
  }
];
---

<section class="py-24 px-6 max-w-6xl mx-auto border-t border-slate-800/50 mt-12">
  <div class="text-center mb-16">
    <h2 class="text-3xl md:text-4xl font-bold text-slate-100">{t('pricing.title')}</h2>
  </div>

  <div class="grid md:grid-cols-3 gap-8">
    {plans.map((plan) => (
      <div class={`relative bg-slate-900/50 border rounded-3xl p-8 flex flex-col ${plan.popular ? 'border-sky-500/50 shadow-2xl shadow-sky-900/20 transform md:-translate-y-4' : 'border-slate-800/80'}`}>
        {plan.popular && (
          <div class="absolute -top-4 start-1/2 -translate-x-1/2 bg-sky-500 text-slate-950 text-xs font-bold px-3 py-1 rounded-full">
            {t('pricing.pro.badge')}
          </div>
        )}
        
        <h3 class="text-xl font-medium text-slate-200 mb-2">{t(`pricing.${plan.key}.name`)}</h3>
        <div class="flex items-baseline gap-1 mb-6">
          <span class="text-4xl font-bold text-white">{t(`pricing.${plan.key}.price`)}</span>
          <span class="text-sm text-slate-400">{t('pricing.monthly')}</span>
        </div>
        
        <ul class="space-y-4 mb-8 flex-1">
          {t(`pricing.${plan.key}.features`).map((feature: string) => (
            <li class="flex items-start gap-3 text-sm text-slate-300">
              <i data-lucide="check" class={`w-5 h-5 shrink-0 ${plan.color}`}></i>
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        <button class={`w-full font-semibold py-3 rounded-xl transition ${plan.btn}`}>
          {t('pricing.cta')}
        </button>
      </div>
    ))}
  </div>
</section>