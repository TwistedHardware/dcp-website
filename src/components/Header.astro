---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Toggle logic: if current is 'en', target is 'ar'
const targetLang = lang === 'en' ? 'ar' : 'en';
const targetPath = `/${targetLang}/`;
const targetLabel = lang === 'en' ? 'العربية' : 'English';
---

<header class="border-b border-slate-800/80 bg-slate-900/70 backdrop-blur-md sticky top-0 z-50 px-6 py-4 flex items-center justify-between">
  <!-- Logo -->
  <div class="flex items-center gap-3">
    <div class="h-9 w-9 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/20">
      <i data-lucide="cpu" class="w-5 h-5 text-white"></i>
    </div>
    <span class="font-semibold text-sm tracking-tight text-slate-200">DCP Cloud</span>
  </div>

  <!-- Actions -->
  <div class="flex items-center gap-4">
    <a href={targetPath} class="text-sm font-medium text-slate-400 hover:text-slate-200 transition-colors">
      {targetLabel}
    </a>
    <div class="h-4 w-px bg-slate-700"></div>
    
    <!-- State 1: Logged Out (Default) -->
    <button id="login-btn" class="text-sm font-medium bg-slate-800 hover:bg-slate-700 text-slate-200 px-4 py-1.5 rounded-lg border border-slate-700 transition shadow-sm flex items-center gap-2">
      <i data-lucide="key" class="w-4 h-4 text-sky-400"></i>
      {t('nav.login')}
    </button>

    <!-- State 2: Logged In (Hidden by default) -->
    <div id="logged-in-actions" class="hidden items-center gap-3">
      <!-- Native link directly to the chat page -->
      <a href={`/${lang}/chat`} class="text-sm font-medium bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 px-4 py-1.5 rounded-lg border border-sky-500/20 transition shadow-sm flex items-center gap-2">
        <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
        {t('nav.workspace')}
      </a>
      <!-- Logout Button -->
      <button id="logout-btn" class="text-slate-400 hover:text-rose-400 p-1.5 rounded-lg transition" title={t('nav.logout')}>
        <i data-lucide="log-out" class="w-4 h-4"></i>
      </button>
    </div>
  </div>
</header>