---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="sticky top-0 z-40 w-full backdrop-blur-lg bg-slate-900/80 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo -->
      <a href={`/${lang}`} class="flex items-center gap-2">
        <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center shadow-lg shadow-indigo-500/20">
          <span class="text-white font-bold text-xl leading-none">D</span>
        </div>
        <span class="text-white font-bold text-xl tracking-tight hidden sm:block">DCP Cloud</span>
      </a>

      <!-- Right Nav -->
      <div class="flex items-center gap-3 sm:gap-4">
        
        <!-- Language Switcher -->
        <a href={lang === 'en' ? '/ar' : '/en'} class="text-sm font-medium text-slate-300 hover:text-white transition px-2 py-1">
          {lang === 'en' ? 'العربية' : 'English'}
        </a>

        <!-- Divider -->
        <div class="w-px h-5 bg-slate-700 hidden sm:block"></div>

        <!-- Logged Out State -->
        <button id="login-btn" class="text-sm font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 px-4 py-2 rounded-lg transition">
          {t('nav.login')}
        </button>

        <!-- Logged In State (Hidden by default, revealed by JS) -->
        <div id="logged-in-actions" class="hidden items-center gap-2 sm:gap-3">
          <button id="logout-btn" class="text-sm font-medium text-slate-400 hover:text-slate-200 transition px-2 py-2">
            {t('nav.logout')}
          </button>
          <a href={`/${lang}/chat`} class="text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded-lg transition shadow-lg shadow-indigo-500/20">
            {t('nav.workspace')}
          </a>
        </div>
        
      </div>
    </div>
  </div>
</header>