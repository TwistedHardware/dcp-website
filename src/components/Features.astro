---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    icon: "shield-check",
    titleKey: "features.privacyTitle",
    descKey: "features.privacyDesc",
    color: "text-sky-400",
    bg: "bg-sky-500/10",
    border: "border-sky-500/20"
  },
  {
    icon: "map-pin",
    titleKey: "features.residencyTitle",
    descKey: "features.residencyDesc",
    color: "text-emerald-400",
    bg: "bg-emerald-500/10",
    border: "border-emerald-500/20"
  },
  {
    icon: "layers",
    titleKey: "features.unifiedTitle",
    descKey: "features.unifiedDesc",
    color: "text-indigo-400",
    bg: "bg-indigo-500/10",
    border: "border-indigo-500/20"
  }
];
---

<section class="py-16 px-6 max-w-6xl mx-auto">
  <div class="grid md:grid-cols-3 gap-6">
    {features.map(feat => (
      <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-2xl p-6 hover:bg-zinc-900/80 transition duration-300">
        <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-5 border ${feat.bg} ${feat.border} ${feat.color}`}>
          <i data-lucide={feat.icon} class="w-6 h-6"></i>
        </div>
        <h3 class="text-lg font-semibold text-zinc-200 mb-2">
          {t(feat.titleKey)}
        </h3>
        <p class="text-sm text-zinc-400 leading-relaxed">
          {t(feat.descKey)}
        </p>
      </div>
    ))}
  </div>
</section>